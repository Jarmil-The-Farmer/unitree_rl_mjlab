<!-- G1 29-DOF collision checking model (no mesh dependencies).
     Same kinematic chain as g1.xml but with only collision capsules.
     Used by ArmCollisionChecker for real-time self-collision prevention.

     Collision filtering via contype/conaffinity bitmasks:
       Left arm  (contype=1, conaffinity=2): collides with right leg, torso, right arm
       Right arm (contype=2, conaffinity=1): collides with left leg, torso, left arm
       Left leg  (contype=0, conaffinity=2): only right arm can collide with it
       Right leg (contype=0, conaffinity=1): only left arm can collide with it
       Torso     (contype=0, conaffinity=3): both arms can collide with it
     This excludes same-side arm-leg contacts (normal in resting poses). -->
<mujoco model="g1_collision_checker">
  <compiler angle="radian"/>
  <option gravity="0 0 0"/>

  <visual>
    <scale contactwidth="0.05" contactheight="0.02"/>
  </visual>

  <default>
    <!-- Left body: only RIGHT arm collides with these. -->
    <default class="left_body_col">
      <geom type="capsule" contype="0" conaffinity="2" condim="1" group="0"
            rgba="0.35 0.5 0.7 0.6"/>
    </default>
    <!-- Right body: only LEFT arm collides with these. -->
    <default class="right_body_col">
      <geom type="capsule" contype="0" conaffinity="1" condim="1" group="0"
            rgba="0.35 0.5 0.7 0.6"/>
    </default>
    <!-- Torso/head: both arms collide. -->
    <default class="torso_col">
      <geom type="capsule" contype="0" conaffinity="3" condim="1" group="0"
            rgba="0.35 0.5 0.7 0.6"/>
    </default>
    <!-- Left arm: collides with right-side body, torso, and right arm. -->
    <default class="left_arm_col">
      <geom type="capsule" contype="1" conaffinity="2" condim="1" group="0"
            rgba="0.2 0.8 0.2 0.7"/>
    </default>
    <!-- Right arm: collides with left-side body, torso, and left arm. -->
    <default class="right_arm_col">
      <geom type="capsule" contype="2" conaffinity="1" condim="1" group="0"
            rgba="0.2 0.8 0.2 0.7"/>
    </default>
    <!-- Visual-only joint markers (no collision). -->
    <default class="joint_vis">
      <geom type="sphere" size="0.02" contype="0" conaffinity="0" density="0" group="1"
            rgba="0.6 0.6 0.6 0.3"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom type="plane" size="3 3 0.01" rgba="0.3 0.3 0.3 0.3" contype="0" conaffinity="0"/>

    <body name="pelvis" pos="0 0 0.79">
      <inertial pos="0 0 -0.07605" quat="1 0 -0.000399148 0" mass="3.813" diaginertia="0.010549 0.0093089 0.0079184"/>
      <freejoint name="floating_base_joint"/>
      <geom name="pelvis_collision" class="torso_col" type="sphere" size="0.07" pos="0 0 -0.08"/>

      <!-- ══ LEFT LEG ══ -->
      <body name="left_hip_pitch_link" pos="0 0.064452 -0.1027">
